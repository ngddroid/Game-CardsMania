    <!-- rules -->
    <string name="spider_rules_title">कैसे खेलें</string>
    <string name="spider_rules_goal_t">लक्ष्य</string>
    <string name="spider_rules_goal_b">एक ही सूट में बादशाह से इक्के तक 8 पूरे सेट बनाएँ। हर पूरा सेट अपने-आप टेबल से हट जाता है।</string>
    <string name="spider_rules_moving_t">चाल चलना</string>
    <string name="spider_rules_moving_b">कोई भी खुला पत्ता उससे एक बड़े पत्ते पर रखें, किसी भी सूट में (7 को किसी भी 8 पर)।</string>
    <string name="spider_rules_groups_t">पत्तों का ग्रुप</string>
    <string name="spider_rules_groups_b">पत्तों का ग्रुप साथ में तभी चलता है जब वह क्रम से नीचे जाए और पूरा एक ही सूट का हो।</string>
    <string name="spider_rules_empty_t">खाली कॉलम</string>
    <string name="spider_rules_empty_b">कोई भी पत्ता या एक सूट का सेट खाली कॉलम में जा सकता है। इन्हें समझदारी से इस्तेमाल करें!</string>
    <string name="spider_rules_dealing_t">पत्ते बाँटना</string>
    <string name="spider_rules_dealing_b">हर कॉलम पर एक पत्ता बाँटने के लिए स्टॉक (ऊपर दाईं ओर) पर टैप करें। खाली कॉलम को भी पत्ता मिलता है।</string>
    <string name="spider_rules_hints_t">संकेत और अनडू</string>
    <string name="spider_rules_hints_b">अटक गए? संकेत एक अच्छी चाल दिखाता है (दूसरी के लिए फिर टैप करें)। अनडू जितनी बार चाहें।</string>
    <string name="spider_rules_score_t">स्कोर</string>
    <string name="spider_rules_score_b">500 से शुरुआत। हर चाल या अनडू पर 1 पॉइंट कटता है, हर पूरे सेट पर 100 मिलते हैं।</string>
    <string name="spider_rules_tip_t">टिप</string>
    <string name="spider_rules_tip_b">बंद पत्ते जल्दी खोलें, और जब भी हो सके एक ही सूट में सेट बनाएँ।</string>
