    <!-- Hub -->
    <string name="mp_title">मल्टीप्लेयर</string>
    <string name="mp_err_permission">Mindi &amp; Mania को आपके Wi-Fi पर फ़ोन ढूँढने की अनुमति चाहिए।</string>
    <string name="mp_play_with_friends">दोस्तों के साथ खेलें</string>
    <string name="mp_hub_intro">सब एक ही Wi-Fi से जुड़ें। एक फ़ोन रूम होस्ट करे, बाकी उसमें जुड़ें — इंटरनेट की ज़रूरत नहीं।</string>
    <string name="mp_host_room">रूम होस्ट करें</string>
    <string name="mp_host_room_sub">मोड, सीटें और बॉट आप चुनें</string>
    <string name="mp_join_room">रूम में जुड़ें</string>
    <string name="mp_join_room_sub">पास का रूम ढूँढें या उसका कोड डालें</string>
    <string name="mp_permission_note">Android पूछेगा कि Mindi &amp; Mania आपके नेटवर्क पर डिवाइस ढूँढ सकता है या नहीं। इसका इस्तेमाल सिर्फ़ एक रूम के फ़ोन जोड़ने के लिए होता है।</string>
    <string name="mp_how_it_works">कैसे काम करता है</string>
    <string name="mp_step_1">1. सभी फ़ोन एक ही Wi-Fi से जोड़ें (या किसी एक फ़ोन के हॉटस्पॉट से)।</string>
    <string name="mp_step_2">2. एक खिलाड़ी \"रूम होस्ट करें\" दबाकर मोड, सीटें और बॉट चुने।</string>
    <string name="mp_step_3">3. दोस्त \"रूम में जुड़ें\" दबाकर रूम चुनें — या उसका कोड टाइप करें।</string>
    <string name="mp_step_4">4. होस्ट स्टार्ट दबाए। 6 तक खिलाड़ी, साथ में बॉट भी।</string>
    <string name="mp_link_wifi">Wi-Fi से जुड़े हैं</string>
    <string name="mp_link_ethernet">लोकल नेटवर्क से जुड़े हैं</string>
