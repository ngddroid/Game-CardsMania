<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CardsMania" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cm_midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.CardsMania.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cm_royal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CardsMania</item>
    </style>
</resources>
