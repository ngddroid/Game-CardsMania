    <!-- rules -->
    <string name="spider_rules_title">How to Play</string>
    <string name="spider_rules_goal_t">Goal</string>
    <string name="spider_rules_goal_b">Build 8 complete runs from King down to Ace in a single suit. Each finished run leaves the table automatically.</string>
    <string name="spider_rules_moving_t">Moving</string>
    <string name="spider_rules_moving_b">Put any face-up card on a card one rank higher, in any suit (a 7 on any 8).</string>
    <string name="spider_rules_groups_t">Moving groups</string>
    <string name="spider_rules_groups_b">A group of cards moves together only when it runs down in order AND all in one suit.</string>
    <string name="spider_rules_empty_t">Empty columns</string>
    <string name="spider_rules_empty_b">Any card or same-suit run can go into an empty column. Use them wisely!</string>
    <string name="spider_rules_dealing_t">Dealing</string>
    <string name="spider_rules_dealing_b">Tap the stock (top right) to deal one card onto every column. Empty columns get a card too.</string>
    <string name="spider_rules_hints_t">Hints &amp; Undo</string>
    <string name="spider_rules_hints_b">Stuck? Hint shows a good move (tap again for another). Undo is unlimited.</string>
    <string name="spider_rules_score_t">Score</string>
    <string name="spider_rules_score_b">Start with 500. Each move or undo costs 1 point, each finished run earns 100.</string>
    <string name="spider_rules_tip_t">Tip</string>
    <string name="spider_rules_tip_b">Turn over face-down cards early, and build in one suit whenever you can.</string>
    <string name="spider_got_it">Got it!</string>

