    <!-- Hub -->
    <string name="mp_title">મલ્ટિપ્લેયર</string>
    <string name="mp_err_permission">Cards Mania ને તમારા Wi-Fi પર ફોન શોધવાની પરવાનગી જોઈએ.</string>
    <string name="mp_play_with_friends">મિત્રો સાથે રમો</string>
    <string name="mp_hub_intro">બધા એક જ Wi-Fi સાથે જોડાય. એક ફોન રૂમ હોસ્ટ કરે, બાકીના એમાં જોડાય — ઇન્ટરનેટની જરૂર નથી.</string>
    <string name="mp_host_room">રૂમ હોસ્ટ કરો</string>
    <string name="mp_host_room_sub">મોડ, સીટો અને બોટ તમે પસંદ કરો</string>
    <string name="mp_join_room">રૂમમાં જોડાઓ</string>
    <string name="mp_join_room_sub">નજીકનો રૂમ શોધો અથવા એનો કોડ નાખો</string>
    <string name="mp_permission_note">Android પૂછશે કે Cards Mania તમારા નેટવર્ક પર ડિવાઇસ શોધી શકે કે નહીં. એનો ઉપયોગ ફક્ત એક રૂમના ફોન જોડવા માટે થાય છે.</string>
    <string name="mp_how_it_works">કેવી રીતે ચાલે છે</string>
    <string name="mp_step_1">1. બધા ફોન એક જ Wi-Fi સાથે જોડો (અથવા કોઈ એક ફોનના હોટસ્પોટ સાથે).</string>
    <string name="mp_step_2">2. એક ખેલાડી \"રૂમ હોસ્ટ કરો\" દબાવીને મોડ, સીટો અને બોટ પસંદ કરે.</string>
    <string name="mp_step_3">3. મિત્રો \"રૂમમાં જોડાઓ\" દબાવીને રૂમ પસંદ કરે — અથવા એનો કોડ ટાઇપ કરે.</string>
    <string name="mp_step_4">4. હોસ્ટ સ્ટાર્ટ દબાવે. 6 સુધી ખેલાડીઓ, સાથે બોટ પણ.</string>
    <string name="mp_link_wifi">Wi-Fi સાથે જોડાયેલા છો</string>
    <string name="mp_link_ethernet">લોકલ નેટવર્ક સાથે જોડાયેલા છો</string>
    <string name="mp_link_hotspot">હોટસ્પોટ ચાલુ છે — મિત્રો એમાં જોડાઈ શકે</string>
    <string name="mp_link_none">Wi-Fi પર નથી — સાથે રમવા જોડાઓ</string>

